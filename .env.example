# Ativa a área de arquivos via SharePoint Embedded (backend /sharepoint/**).
# Com false, o botão 'Arquivos Editáveis' continua abrindo o linkDrive do Clifor.
REACT_APP_SHAREPOINT_ENABLED=true

# Local-only test gate. Requires SharePoint enabled and permits the RHSC test host only.
# Keep false unless a TEST Graph app and the RHSC test container registry were explicitly prepared.
REACT_APP_SHAREPOINT_TEST_ENABLED=false

# Catalog UI is complete. Requires the corresponding backend catalog/copy endpoints
# and REACT_APP_SHAREPOINT_ENABLED=true to expose the Arquivos Editaveis area.
REACT_APP_MODEL_CATALOG_ENABLED=true

# Enables the product-based read-only client library and its staff controls.
# Enable only after the backend V23 migration and BIBLIOTECA_ENABLED/SHAREPOINT_ENABLED configuration.
REACT_APP_LIBRARY_ENABLED=false
